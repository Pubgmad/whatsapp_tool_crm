# Required production runtime
DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_crm
DATABASE_SSL=false
AUTH_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-another-long-random-secret
APP_URL=http://localhost:3000

# Optional owner workspace seed values
SEED_EMAIL=
SEED_PASSWORD=
SEED_BUSINESS_NAME=

# Optional permanent Meta App Review workspace initializer
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_NAME=
REVIEWER_BUSINESS_NAME=

# Meta / WhatsApp Business Platform
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_OAUTH_REDIRECT_URI=
META_GRAPH_API_VERSION=v26.0
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=change-me
META_WEBHOOK_SIGNATURE_REQUIRED=true
WEBHOOK_URL=http://localhost:3000/api/webhooks/meta

# Campaign queue processing
JOB_RUNNER_SECRET=replace-with-a-long-random-queue-secret
CAMPAIGN_QUEUE_BATCH_SIZE=25
AUTOMATION_QUEUE_BATCH_SIZE=25
AUTOMATION_WEBHOOK_BATCH_SIZE=10
QUEUE_WORKER_CRON_URL=/api/jobs/run

# Super Admin / SaaS owner access
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_SESSION_SECRET=replace-with-a-long-random-super-admin-secret

# SaaS subscription configuration
DEFAULT_SUBSCRIPTION_PLAN_CODE=
SUBSCRIPTION_PLANS_JSON=
# Optional plan JSON keys: code, name, billingInterval, priceCents, currency, trialDays, contactLimit, campaignLimit, userLimit, automationFlowLimit, monthlyMessageLimit, isActive
