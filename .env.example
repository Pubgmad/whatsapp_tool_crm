# Required production runtime
DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_crm
DATABASE_SSL=false
AUTH_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-another-long-random-secret
APP_URL=http://localhost:3000

# Optional sample data seed values
SEED_EMAIL=
SEED_PASSWORD=
SEED_BUSINESS_NAME=

# Meta / WhatsApp Business Platform
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=change-me
META_WEBHOOK_SIGNATURE_REQUIRED=false
WEBHOOK_URL=http://localhost:3000/api/webhooks/meta



# Campaign queue processing
JOB_RUNNER_SECRET=replace-with-a-long-random-queue-secret
CAMPAIGN_QUEUE_BATCH_SIZE=25
