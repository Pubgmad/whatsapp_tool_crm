# Required production runtime
# Use a non-superuser runtime role without BYPASSRLS.
DATABASE_URL=postgresql://crm_app:password@localhost:5432/whatsapp_crm
# Production (VPS): set DATABASE_URL only on the server .env — not on a laptop pointing at prod.
# Integration tests use TEST_DATABASE_URL only (local Postgres or CI). npm test will NOT auto-target a remote prod URL.
# TEST_DATABASE_URL=postgresql://crm_app:password@127.0.0.1:5432/whatsapp_crm_test
# Optional: npm run test:db runs db:init then the full test suite against local DATABASE_URL.
# Migration/seed commands may use an elevated role; never use it for the running app.
DATABASE_MIGRATION_URL=
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_SSL_INSECURE=false
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SECRET_PREVIOUS=
CSRF_SECRET=replace-with-a-separate-long-random-secret
ENCRYPTION_KEY=replace-with-another-long-random-secret
ENCRYPTION_KEY_PREVIOUS=
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Identity security and transactional email
# Always required for new signups in production; optional in local development
EMAIL_VERIFICATION_REQUIRED=true
RESEND_API_KEY=
EMAIL_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=
# Dialogflow CX (platform service account JSON on one line; per-workspace agent ID in AI settings)
DIALOGFLOW_PROJECT_ID=
GOOGLE_DIALOGFLOW_SERVICE_ACCOUNT_JSON=
# Optional live Flow availability integrations
# Google Cloud OAuth web client: redirect URI https://your-domain/api/whatsapp/availability/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A currently supported Shopify Admin GraphQL release, for example YYYY-MM.
SHOPIFY_ADMIN_API_VERSION=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Set true after mandatory compliance topics use APP_URL/api/webhooks/shopify/privacy
# in Shopify app configuration or the Partner Dashboard.
SHOPIFY_PRIVACY_WEBHOOKS_CONFIGURED=false
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Salesforce External Client App: callback https://your-domain/api/crm/salesforce/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=
# Optional sandbox login endpoint: https://test.salesforce.com
SALESFORCE_LOGIN_URL=
AI_RATE_LIMIT=20
MFA_ISSUER=WhatsApp CRM
LOGIN_RATE_LIMIT=10
PASSWORD_RATE_LIMIT=5
API_RATE_LIMIT=300

# Optional owner workspace seed values
SEED_EMAIL=
SEED_PASSWORD=
SEED_BUSINESS_NAME=

# Optional permanent Meta App Review workspace initializer
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_NAME=
REVIEWER_BUSINESS_NAME=

# Meta / WhatsApp Business Platform
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_COEXISTENCE_CONFIG_ID=
META_OAUTH_REDIRECT_URI=
META_GRAPH_API_VERSION=v26.0
META_BUSINESS_PORTFOLIO_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
# Enable only after Meta grants this platform credit-line sharing eligibility.
META_CREDIT_SHARING_ENABLED=false
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SIGNATURE_REQUIRED=true
WHATSAPP_CALL_TURN_URLS=
WHATSAPP_CALL_TURN_SECRET=
WEBHOOK_URL=http://localhost:3000/api/webhooks/meta

# Campaign queue processing
JOB_RUNNER_SECRET=replace-with-a-long-random-queue-secret
CAMPAIGN_QUEUE_BATCH_SIZE=25
CAMPAIGN_QUEUE_MAX_LAG_SECONDS=600
# Re-resolve dynamic segment audiences before campaign sends (minutes, 1–1440)
DYNAMIC_AUDIENCE_SYNC_MINUTES=15
# Set true only when operators accept autonomous AI action execution (still owner-gated in UI).
AI_AUTONOMOUS_ACTIONS_ENABLED=false
AUTOMATION_QUEUE_BATCH_SIZE=25
AUTOMATION_WEBHOOK_BATCH_SIZE=10
QUEUE_WORKER_CRON_URL=/api/jobs/run
JOB_RUNNER_URL=http://127.0.0.1:3000
JOB_POLL_INTERVAL_MS=15000
JOB_CONCURRENCY=4
JOB_BATCH_SIZE=25
WORKER_RETENTION_INTERVAL_HOURS=24
TRACKED_LINK_RETENTION_DAYS=30
INTEGRATION_DISPATCH_WINDOW_SECONDS=120
INTEGRATION_RESERVATION_TTL_SECONDS=300
WORKSPACE_API_KEY_EXPIRY_DAYS=90
WORKSPACE_API_KEY_RPM=60
# Comma-separated feature keys disabled for new workspaces. Empty uses platform defaults.
PLATFORM_DEFAULT_DISABLED_FEATURES=
META_WEBHOOK_MAX_LAG_SECONDS=300
CALENDAR_FULFILLMENT_MAX_LAG_SECONDS=300
RETENTION_BATCH_SIZE=500

# Super Admin / SaaS owner access
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_SESSION_SECRET=replace-with-a-long-random-super-admin-secret
SUPER_ADMIN_SESSION_SECRET_PREVIOUS=

# SaaS subscription configuration
DEFAULT_SUBSCRIPTION_PLAN_CODE=
SUBSCRIPTION_PLANS_JSON=
RAZORPAY_KEY_ID=
# Live keys are required on production. Merchant checkout keys are entered by each company owner.
RAZORPAY_KEY_SECRET=
# Subscribe platform subscription events at APP_URL/api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
SUBSCRIPTION_ENFORCEMENT_ENABLED=true
# Optional plan JSON keys: code, name, billingInterval, priceCents, currency, trialDays, contactLimit, campaignLimit, userLimit, automationFlowLimit, monthlyMessageLimit, isActive
PLATFORM_BRAND_NAME=
PLATFORM_COMPANY_NAME=
PLATFORM_SUPPORT_EMAIL=
# Comma-separated approved HTTPS hostnames for tenant outbound webhooks.
WORKSPACE_WEBHOOK_ALLOWED_HOSTS=
# Header set and sanitized by your trusted edge proxy for workspace API IP policies.
# Supported: x-real-ip, cf-connecting-ip, fly-client-ip, true-client-ip.
WORKSPACE_API_CLIENT_IP_HEADER=
# Pre-auth requests per minute per trusted client IP (or token hash when unavailable).
INTEGRATION_AUTH_RATE_LIMIT=1000
