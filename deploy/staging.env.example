# Isolated staging only — never point these at production.
# App dir on VPS: /var/www/whatsapp-crm-staging
# PM2: ecosystem.staging.config.cjs → whatsapp-crm-staging + whatsapp-crm-staging-worker
# Port: 3001 (production stays on 3000)

NODE_ENV=production
PORT=3001
APP_URL=https://staging-crm.mathstrat-sites.com
ALLOWED_ORIGINS=https://staging-crm.mathstrat-sites.com

# Separate database (not whatsapp_crm)
DATABASE_URL=postgresql://whatsapp_crm_staging_user:CHANGE_ME@localhost:5432/whatsapp_crm_staging
DATABASE_MIGRATION_URL=postgresql://whatsapp_crm_staging_user:CHANGE_ME@localhost:5432/whatsapp_crm_staging
DATABASE_SSL=false

AUTH_SECRET=replace-with-staging-auth-secret
CSRF_SECRET=replace-with-staging-csrf-secret
ENCRYPTION_KEY=replace-with-staging-encryption-key

# Distinct from production worker secret
JOB_RUNNER_SECRET=replace-with-staging-job-runner-secret
JOB_RUNNER_URL=http://127.0.0.1:3001

# Keep live customer traffic off staging until a dedicated test WABA exists.
# Do not register Meta production webhooks against APP_URL above.
# Leave META_* empty or use an authorized test app only.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=

EMAIL_VERIFICATION_REQUIRED=false
SUBSCRIPTION_ENFORCEMENT_ENABLED=false

# Optional local/CI integration harness
# TEST_DATABASE_URL=postgresql://crm_staging:staging_local_only@127.0.0.1:5433/whatsapp_crm_staging
# TEST_DATABASE_ADMIN_URL=postgresql://crm_staging:staging_local_only@127.0.0.1:5433/postgres
