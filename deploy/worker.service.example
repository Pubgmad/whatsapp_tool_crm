[Unit]
Description=WhatsApp CRM queue worker (automation, campaigns, webhooks)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/whatsapp-crm
EnvironmentFile=/opt/whatsapp-crm/.env
# Requires APP_URL=https://... and JOB_RUNNER_SECRET
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
